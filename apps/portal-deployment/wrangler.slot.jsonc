{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "another-portal-slot",
  "main": "./src/slot.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "PORTAL_SLOT": "unset"
  },
  "env": {
    "blue": {
      "name": "another-portal-slot-blue",
      "vars": {
        "PORTAL_SLOT": "blue"
      }
    },
    "green": {
      "name": "another-portal-slot-green",
      "vars": {
        "PORTAL_SLOT": "green"
      }
    }
  }
}
